                  <stringProp name="Argument.value">{&quot;email&quot;:&quot;load.user.${__threadNum}.${__UUID()}@example.com&quot;,&quot;firstName&quot;:&quot;Load&quot;,&quot;lastName&quot;:&quot;User${__threadNum}&quot;}</stringProp>
